{
  "name": "dsh-pet",
  "version": "0.3.8",
  "description": "吃白饭的蓝色大肥鱼，赖在 DeepSeek Harness 里不走了。平时爱玩魔方、爱吃各种零食、偶尔打个盹，闲不住就在桌面上溜达两圈，被你拖来甩去也照旧赖着；你忙起来它跟着忙前忙后，也会帮你打理余额钱包，闲下来爱碎碎念，还乐意陪你唠两句。",
  "icon": "assets/logo.png",
  "homepage": "https://github.com/PC2005-cloud/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PC2005-cloud/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/PC2005-cloud/dsh-pet/issues"
  },
  "type": "module",
  "main": "lib/app.js",
  "bin": {
    "dsh-pet-standalone": "lib/standalone.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/sound",
    "assets/config.jsonc",
    "assets/logo.png",
    "scripts/ensure-electron.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0",
    "openai": "7.39.0",
    "zod": "4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "incompatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}